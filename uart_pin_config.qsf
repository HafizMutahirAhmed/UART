# CLOCK (50MHz)
set_location_assignment PIN_R8 -to CLK

# RESET and ENABLE (KEY0, KEY1)
set_location_assignment PIN_AE14 -to Reset
set_location_assignment PIN_AF14 -to EN

# SWITCHES → DataIN
set_location_assignment PIN_AB12 -to DataIN[0]
set_location_assignment PIN_AC12 -to DataIN[1]
set_location_assignment PIN_AD11 -to DataIN[2]
set_location_assignment PIN_AC11 -to DataIN[3]
set_location_assignment PIN_AF10 -to DataIN[4]
set_location_assignment PIN_AD10 -to DataIN[5]
set_location_assignment PIN_AE10 -to DataIN[6]
set_location_assignment PIN_AA14 -to DataIN[7]

# LEDs → DataOUT
set_location_assignment PIN_V16 -to DataOUT[0]
set_location_assignment PIN_W16 -to DataOUT[1]
set_location_assignment PIN_V17 -to DataOUT[2]
set_location_assignment PIN_W17 -to DataOUT[3]
set_location_assignment PIN_W15 -to DataOUT[4]
set_location_assignment PIN_V15 -to DataOUT[5]
set_location_assignment PIN_AF23 -to DataOUT[6]
set_location_assignment PIN_AF22 -to DataOUT[7]

# GPIO_0[0] → UART TX
set_location_assignment PIN_AF26 -to tx
